# Heslo do adminu (/admin). Bez něj je admin nedostupný.
ADMIN_PASSWORD=
# Heslo do veřejné části. Nechte prázdné, až bude kalkulačka pro klienty otevřená.
PUBLIC_PASSWORD=
# Dlouhý náhodný řetězec, kterým se podepisuje přihlášení. Když chybí, po každém restartu se všichni odhlásí.
SESSION_SECRET=
# Složka pro nastavení a poptávky. Na Railway cesta k volume, např. /data.
DATA_DIR=
# Nepovinné: Slack Incoming Webhook, kam chodí nové poptávky.
SLACK_WEBHOOK_URL=
